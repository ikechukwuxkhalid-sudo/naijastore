# ── Naija Dimes Hub ─────────────────────────────────────────────
# Copy this file to .env and fill in your values. NEVER commit .env

# Port for the web server (Render injects PORT automatically)
PORT=3000

# Random secret used to sign sessions — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Public URL of the store (used for links). Leave empty for auto-detect.
APP_URL=

# Initial Super Admin (created on first boot / seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=NaijaDimes2026!
ADMIN_EMAIL=admin@naijadimeshub.com

# Security toggles
NODE_ENV=production          # production | development
TRUST_PROXY=1                # 1 when behind nginx/Render proxy
MAINTENANCE_MODE=0           # 1 = customer site shows maintenance page (admin still works)

# Rate limiting (requests per window)
RATE_LOGIN=20                # per 15 min per IP
RATE_ORDER=15                # per 10 min per IP
RATE_PAYMENT=10              # per 10 min per IP
RATE_CONTACT=5               # per 10 min per IP

# Upload limits (bytes) — payment screenshots
MAX_UPLOAD_MB=5
